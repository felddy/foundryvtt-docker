#!/usr/bin/env sh

# render-docs-check: verify every rendered document is in sync with its template.
#
# Derives the CONTAINER_VERSION from src/version.txt (the single source of
# truth) and asks render-docs to re-render every '*.j2' template in the
# repository in memory, comparing each against its committed output.  Exits 0
# when everything matches; otherwise prints a unified diff for each stale file
# and exits non-zero.  Nothing is written.  Intended to run as a local
# pre-commit hook.

set -eu

VERSION_FILE="src/version.txt"

if [ ! -s "$VERSION_FILE" ]; then
  echo "ERROR: ${VERSION_FILE} is missing or empty." >&2
  exit 1
fi

# Derive CONTAINER_VERSION from the single source of truth (whitespace trimmed).
CONTAINER_VERSION=$(tr -d '[:space:]' < "$VERSION_FILE")

# Render every template in memory and compare against the committed outputs.
# render-docs prints diffs and exits non-zero when anything is stale.
exec uv run --group dev render-docs --check "$CONTAINER_VERSION"
