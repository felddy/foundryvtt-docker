---
services:
  foundry:
    image: ghcr.io/felddy/foundryvtt:{{ major_version }}
    hostname: my_foundry_host
    environment:
      - FOUNDRY_HOSTNAME=<vtt.example.com>
      - FOUNDRY_PROXY_SSL=true
      - FOUNDRY_TELEMETRY=true
    volumes:
      - type: bind
        source: ./volumes/foundry_data
        target: /data
    secrets:
      - source: foundry_secrets
        target: config.json
    restart: unless-stopped

  livekit:
    image: livekit/livekit-server:v1.13.7
    command: --config /etc/livekit/livekit.yaml
    ports:
      # WebRTC over TCP: a fallback for players whose networks block UDP.
      - target: 7881
        published: 7881
        protocol: tcp
      # WebRTC media over UDP: every participant's audio and video,
      # multiplexed onto this single port.
      - target: 7882
        published: 7882
        protocol: udp
    volumes:
      - type: bind
        source: ./livekit.yaml
        target: /etc/livekit/livekit.yaml
        read_only: true
    restart: unless-stopped

  caddy:
    image: caddy:2
    depends_on:
      - foundry
      - livekit
    environment:
      - SITE_ADDRESS=<vtt.example.com>
      - LIVEKIT_ADDRESS=<livekit.example.com>
    ports:
      # HTTP, used for ACME challenges and redirecting to HTTPS.
      - target: 80
        published: 80
        protocol: tcp
      # HTTPS.
      - target: 443
        published: 443
        protocol: tcp
      # HTTPS over HTTP/3 (QUIC).
      - target: 443
        published: 443
        protocol: udp
    volumes:
      - type: bind
        source: ./Caddyfile
        target: /etc/caddy/Caddyfile
        read_only: true
      - type: volume
        source: caddy_data
        target: /data
      - type: volume
        source: caddy_config
        target: /config
    restart: unless-stopped

volumes:
  caddy_config:
  caddy_data:

secrets:
  foundry_secrets:
    file: foundry_secrets.json
