{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customDatasources": {
    "foundryvtt": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/foundryvtt/foundryvtt/milestones?state=closed&per_page=100&sort=due_on&direction=desc",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": [$[state = \"closed\" and $contains(title, \"Stable\")].{ \"version\": $match(title, /- (\\d+\\.\\d+)$/).groups[0] & \".0\", \"releaseTimestamp\": updated_at, \"changelogUrl\": \"https://foundryvtt.com/releases/\" & $match(title, /- (\\d+\\.\\d+)$/).groups[0] }[version != \".0\"]], \"homepage\": \"https://foundryvtt.com\", \"sourceUrl\": \"https://github.com/foundryvtt/foundryvtt\" }"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "custom.foundryvtt",
      "depNameTemplate": "foundryvtt",
      "description": "Track FoundryVTT stable releases via src/version.txt",
      "managerFilePatterns": [
        "/^src/version\\.txt$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "npm",
      "depNameTemplate": "@foundryvtt/foundryvtt-cli",
      "description": "Track the Foundry VTT CLI version pinned in the Dockerfile",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG FOUNDRYVTT_CLI_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "npm"
    }
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "commitMessageTopic": "Foundry VTT CLI",
      "labels": [
        "bot :robot:",
        "dependencies :game_die:"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchDepNames": [
        "@foundryvtt/foundryvtt-cli"
      ]
    },
    {
      "commitMessageTopic": "FoundryVTT",
      "labels": [
        "bot :robot:",
        "dependencies :game_die:"
      ],
      "matchDatasources": [
        "custom.foundryvtt"
      ],
      "postUpgradeTasks": {
        "commands": [
          "sh render-docs-update"
        ],
        "executionMode": "branch",
        "fileFilters": [
          "README.md",
          "docs/**"
        ]
      },
      "prBodyNotes": [
        "The rendered documentation (`README.md` and `docs/**`) was regenerated from its templates as part of this update."
      ]
    }
  ]
}
